# Server Debug & Persistence Configuration
DEBUG_SAVE_REDACTED=1
REDACTED_IMAGES_DIR=debug_redacted_images

# VLM Planner Configuration
# Provider: "ollama", "openai", "openai-compatible", "litellm", etc.
VLM_PROVIDER=ollama
VLM_MODEL=llama3.2-vision
VLM_BASE_URL=
VLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
VLM_TIMEOUT_SECONDS=30.0
