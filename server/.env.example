# ==============================================================================
# Server Ingress Authentication (Extension Client -> Planning Server)
# ==============================================================================
# Authentication token for extension clients connecting to the FastAPI backend.
# The extension passes this as "Authorization: Bearer <SERVER_API_KEY>" or "X-API-Key: <token>".
# Upstream model provider API keys NEVER transit the browser extension.
SERVER_API_KEY=
REQUIRE_AUTH=0

# ==============================================================================
# Upstream VLM Provider Credentials (SERVER-SIDE-ONLY CONFIGURATION)
# ==============================================================================
# In production/SIH deployments, upstream provider credentials must reside
# exclusively on the trusted server. Setting VLM_API_KEY here ensures the server
# uses this credential and ignores any deprecated client-supplied keys.
# Supported providers: "ollama", "openai", "openai-compatible", "litellm", etc.
VLM_PROVIDER=ollama
VLM_MODEL=llama3.2-vision
VLM_BASE_URL=
VLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
VLM_TIMEOUT_SECONDS=30.0

# ==============================================================================
# Server Debug & Persistence Configuration
# ==============================================================================
# PRIVACY WARNING: Setting DEBUG_SAVE_REDACTED=1 persists redacted screenshots to disk.
# Keep disabled (0) by default to prevent leaking sensitive on-screen user data.
DEBUG_SAVE_REDACTED=0
REDACTED_IMAGES_DIR=debug_redacted_images

# ==============================================================================
# Step History Cache Configuration
# ==============================================================================
STEP_HISTORY_TTL_SECONDS=1800
STEP_HISTORY_MAX_KEYS=10000
